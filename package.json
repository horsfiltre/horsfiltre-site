{
  "name": "horsfiltre-site",
  "private": true,
  "description": "Site public de Hors Filtre",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:html": "html-validate \"public/**/*.html\" \"admin/**/*.html\"",
    "lighthouse": "node scripts/lighthouse.mjs",
    "dev": "wrangler pages dev public",
    "check": "npm run lint:html && npm test",
    "test": "node --test \"shared/test/*.test.mts\" \"api/test/*.test.mts\" \"admin/test/*.test.mjs\" \"tests/public/*.test.mjs\"",
    "test:integration": "node --test \"api/test-integration/*.integration.mts\"",
    "construire:api": "node scripts/construire-api.mjs",
    "admin:dev": "wrangler pages dev admin --port 8788"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1153.0",
    "@aws-sdk/client-ssm": "3.1153.0",
    "@aws-sdk/lib-dynamodb": "3.1153.0",
    "chrome-launcher": "1.2.2",
    "esbuild": "0.28.2",
    "html-validate": "11.17.0",
    "lighthouse": "13.5.0",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
